#!name=G1 Ultra Free Test
#!desc=Ánh xạ các nút Google One iOS sang ứng viên mã Ultra 30TB (free 1 tháng / giảm 90%) để test nhanh
#!system=ios

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-ultra-free = type=http-response,pattern=^https:\/\/one\.google\.com\/(ai|upsell|plans|storage),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/xtapo/g1-ultra-free/main/g1-ultra-free.js

[MITM]
hostname = %APPEND% one.google.com
